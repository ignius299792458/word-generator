.pytest_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
coverage.json
htmlcov/
pytestdebug.log

.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.dmypy.json
dmypy.json

# Benchmark and mutation-testing output
.benchmarks/
.mutmut-cache/
mutants/

